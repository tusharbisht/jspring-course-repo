{
  "name": "Skillslab \u2014 Claude Code for Spring Boot",
  "image": "tusharbisht1391/skillslab:latest",
  "containerEnv": {
    "SKILLSLAB_API_URL": "http://52.88.255.208",
    "SKILLSLAB_WEB_URL": "http://52.88.255.208",
    "TERM": "xterm-256color",
    "COLORTERM": "truecolor"
  },
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
  },
  "workspaceFolder": "/work",
  "workspaceMount": "source=${localWorkspaceFolder},target=/work,type=bind",
  "customizations": {
    "vscode": {
      "extensions": [
        "tusharbisht1391.skillslab",
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "(curl -fsSL http://52.88.255.208/dl/skillslab.vsix -o /tmp/skillslab.vsix && code --install-extension /tmp/skillslab.vsix) || echo '[skillslab] vsix install skipped (network or server) \u2014 install manually' && skillslab --version && claude --version && echo Ready"
}
